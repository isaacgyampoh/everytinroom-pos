# Which Supabase project this build talks to.
#
# Both are OPTIONAL: left unset, the build falls back to the live project that
# used to be hardcoded in src/lib/supabase.js, so an existing deployment keeps
# working untouched. Set them to point a deployment somewhere else — a new
# Vercel project, a staging backend, a fresh Supabase project after a move.
#
# Vite inlines these AT BUILD TIME. Changing them in the Vercel dashboard does
# nothing until the next deploy, and `vercel env pull` + a rebuild is how a
# local till picks them up.
#
# The anon key is a public, row-level-security-scoped key — it is meant to ship
# in the browser bundle. The service-role key must NEVER be put here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

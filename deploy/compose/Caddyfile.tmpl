# ===========================================================================
# The only thing on this server listening to the internet.
#
# It terminates HTTPS, gets its own certificates, and routes the four URL
# prefixes supabase-js expects. One file per application lives in
# /etc/caddy/sites and is written by provision-app.sh, so adding an
# application never means editing this file.
# ===========================================================================

{
	# A real address: Let's Encrypt uses it for expiry warnings, and without
	# one you find out a certificate failed to renew from a customer.
	#
	# This is a TEMPLATE because the directive cannot be left empty. It used
	# to read `email {$ACME_EMAIL}`, taking the value from Caddy's own process
	# environment -- which the container was never given, so Caddy parsed
	# `email` with no argument and exited:
	#
	#   parsing caddyfile tokens for 'email': wrong argument count
	#
	# Worse, the pre-start validation PASSED, because that check was handed
	# the variable explicitly while the real container was not. A validation
	# that runs in a different environment from the thing it validates is not
	# a validation. bootstrap.sh now substitutes this line and validates the
	# generated file, so there is no environment to disagree about.
	__ACME_EMAIL_LINE__

	# Caddy's admin API can reconfigure the proxy over HTTP. It binds to
	# localhost by default, which is already not public, but nothing here
	# needs it and a management interface that does not exist cannot be
	# reached. Reload with `docker compose restart caddy`.
	admin off

	servers {
		# Cloudflare sits in front, so the client address arrives in a header.
		# Without this every request appears to come from Cloudflare and rate
		# limiting and logs become useless.
		#
		# `trusted_proxies cloudflare` is NOT used here, although it reads
		# better. That form needs a third-party module
		# (WeidiDeng/caddy-cloudflare-ip) which is not in the official caddy
		# image, so Caddy exits at startup and the container restarts forever.
		# The staging run found exactly that: bootstrap reported
		# "central-caddy is 'restarting' rather than running" and every later
		# check failed behind it.
		#
		# `static` is built in. The ranges are Cloudflare's published list,
		# fetched 2026-11-08 from https://www.cloudflare.com/ips-v4 and
		# .../ips-v6. They change rarely; re-check them at upgrade time.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(security_headers) {
	header {
		# HSTS. Only safe because every hostname here is served over HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Do not advertise the proxy or its version.
		-Server
	}
}

# CORS IS DELIBERATELY NOT SET HERE.
#
# PostgREST and storage-api already send Access-Control-Allow-Origin, exactly
# as Supabase's hosted API does today. Adding a second header here would make
# the browser see two values for one header and refuse the response outright,
# so the till would fail in a way that looks like the database is down.
# If origins ever need restricting, strip the upstream header first:
#   header_down -Access-Control-Allow-Origin

# A plain health endpoint on the bare IP, for uptime checks that run before
# DNS exists and for `curl localhost/healthz` on the box itself.
:80 {
	respond /healthz "ok" 200
	respond "not found" 404
}

import /etc/caddy/sites/*.caddy
